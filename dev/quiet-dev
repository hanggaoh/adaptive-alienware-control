#!/usr/bin/env bash
set -euo pipefail
jobs=${QUIET_BUILD_JOBS:-8}
threads=${QUIET_CPU_THREADS:-6}
for value in "$jobs" "$threads"; do
  [[ "$value" =~ ^[1-9][0-9]*$ && "$value" -le 20 ]] || { echo 'Thread counts must be integers from 1 to 20.' >&2; exit 2; }
done
export CMAKE_BUILD_PARALLEL_LEVEL="$jobs" MAX_JOBS="$jobs"
export OMP_NUM_THREADS="$threads" MKL_NUM_THREADS="$threads"
export OPENBLAS_NUM_THREADS="$threads" NUMEXPR_NUM_THREADS="$threads"
export OMP_DYNAMIC=TRUE
mode=${1:-help}
[[ $# -eq 0 ]] || shift
case "$mode" in
  make) exec make -j"$jobs" "$@" ;;
  cmake) exec cmake --build "${1:?Supply build directory}" --parallel "$jobs" "${@:2}" ;;
  ninja) exec ninja -j"$jobs" "$@" ;;
  run) [[ $# -gt 0 ]] || { echo 'Supply a command.' >&2; exit 2; }; exec "$@" ;;
  torch)
    python=${1:?Supply Python executable, e.g. python}; shift
    script=${1:?Supply training script}; shift
    exec "$python" -c '
import os, runpy, sys
import torch
torch.set_num_threads(int(os.environ["OMP_NUM_THREADS"]))
torch.set_num_interop_threads(2)
sys.argv = sys.argv[1:]
runpy.run_path(sys.argv[0], run_name="__main__")
' "$script" "$@"
    ;;
  help|--help|-h)
    printf '%s\n' 'Quiet development (opt-in; GPU unrestricted):' \
      '  quiet-dev make [targets/options]' \
      '  quiet-dev cmake build [options]' \
      '  quiet-dev ninja [targets/options]' \
      '  quiet-dev run python script.py [args]' \
      '  quiet-dev torch python train.py [args]' \
      'Defaults: build jobs=8; CPU library threads=6; Torch inter-op=2.' \
      'Override with QUIET_BUILD_JOBS / QUIET_CPU_THREADS for one invocation.' \
      'DataLoader num_workers is NOT changed; choose 2-4 in your own code.'
    ;;
  *) echo "Unknown mode: $mode" >&2; exit 2 ;;
esac
